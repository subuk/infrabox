{
  "uid": "infrabox-health",
  "title": "InfraBox Health",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "infrabox"
  ],
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Appliance health",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "infrabox-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(vector(2) and (count(infrabox:check_state{state=\"critical\"}) > 0)) or (vector(3) unless (infrabox:coverage_ok == 1 and on() (time() - timestamp(infrabox:coverage_ok) < 90) and on() (time() - infrabox_worker_heartbeat_timestamp_seconds < 90))) or (vector(1) and (count(infrabox:check_state{state=\"warning\"}) > 0)) or vector(0)",
          "instant": true,
          "legendFormat": "{% raw %}{{component}}{% endraw %} / {% raw %}{{check_id}}{% endraw %} {% raw %}{{state}}{% endraw %} {% raw %}{{alertstate}}{% endraw %}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "UNKNOWN",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              },
              {
                "color": "gray",
                "value": 3
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Healthy",
                  "color": "green"
                },
                "1": {
                  "text": "Warning",
                  "color": "orange"
                },
                "2": {
                  "text": "Critical",
                  "color": "red"
                },
                "3": {
                  "text": "Unknown",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background"
      }
    },
    {
