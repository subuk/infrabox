GF_SERVER_DOMAIN=grafana.{{ infrabox_domain }}
GF_SERVER_ROOT_URL=https://grafana.{{ infrabox_domain }}/
GF_DATABASE_TYPE=postgres
GF_DATABASE_HOST=postgresql.{{ infrabox_internal_domain }}:5432
GF_DATABASE_NAME=grafana
GF_DATABASE_USER=grafana
GF_DATABASE_PASSWORD={{ grafana_database_password }}
GF_DATABASE_SSL_MODE=verify-full
GF_DATABASE_CA_CERT_PATH=/run/infrabox-ca/root-ca.crt
GF_SECURITY_DISABLE_INITIAL_ADMIN_CREATION=true
# Pinned Generic OAuth logs opaque access tokens at warning level while trying
# JWT fallback extraction. Retain errors, suppress token-bearing warnings/debug.
GF_LOG_FILTERS=oauth.generic_oauth:error
GF_AUTH_DISABLE_LOGIN=true
GF_AUTH_BASIC_ENABLED=true
GF_AUTH_DISABLE_LOGIN_FORM=true
GF_AUTH_LDAP_ENABLED=true
GF_AUTH_LDAP_CONFIG_FILE=/etc/grafana/ldap.toml
GF_AUTH_LDAP_ALLOW_SIGN_UP=true
GF_AUTH_LDAP_SKIP_ORG_ROLE_SYNC=false
LDAP_READER_PASSWORD={{ lldap_reader_password }}
GF_AUTH_GENERIC_OAUTH_ENABLED=true
GF_AUTH_GENERIC_OAUTH_NAME=InfraBox
GF_AUTH_GENERIC_OAUTH_ALLOW_SIGN_UP=true
GF_AUTH_GENERIC_OAUTH_CLIENT_ID={{ identity_clients.grafana.client_id }}
GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET={{ identity_clients.grafana.client_secret }}
GF_AUTH_GENERIC_OAUTH_SCOPES=openid profile roles
GF_AUTH_GENERIC_OAUTH_AUTH_URL=https://vault.{{ infrabox_domain }}/ui/vault/identity/oidc/provider/infrabox/authorize
GF_AUTH_GENERIC_OAUTH_TOKEN_URL=https://vault.{{ infrabox_domain }}/v1/identity/oidc/provider/infrabox/token
GF_AUTH_GENERIC_OAUTH_API_URL=https://vault.{{ infrabox_domain }}/v1/identity/oidc/provider/infrabox/userinfo
GF_AUTH_GENERIC_OAUTH_LOGIN_ATTRIBUTE_PATH=preferred_username
GF_AUTH_GENERIC_OAUTH_EMAIL_ATTRIBUTE_PATH=email
GF_AUTH_GENERIC_OAUTH_NAME_ATTRIBUTE_PATH=name
GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_PATH=contains(groups[*], 'infrabox:grafana:admin') && 'GrafanaAdmin' || contains(groups[*], 'infrabox:grafana:editor') && 'Editor' || contains(groups[*], 'infrabox:grafana:reader') && 'Viewer'
GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_STRICT=true
GF_AUTH_GENERIC_OAUTH_ALLOW_ASSIGN_GRAFANA_ADMIN=true
GF_AUTH_GENERIC_OAUTH_SKIP_ORG_ROLE_SYNC=false
GF_AUTH_GENERIC_OAUTH_USE_PKCE=true
GF_AUTH_GENERIC_OAUTH_TLS_CLIENT_CA=/run/infrabox-ca/root-ca.crt
GF_AUTH_GENERIC_OAUTH_TLS_SKIP_VERIFY_INSECURE=false
GF_USERS_ALLOW_SIGN_UP=false
GF_AUTH_ANONYMOUS_ENABLED=false
GF_ANALYTICS_REPORTING_ENABLED=false
GF_ANALYTICS_CHECK_FOR_UPDATES=false
GF_PLUGINS_PREINSTALL_DISABLED=true
