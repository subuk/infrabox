[Unit]
Description=InfraBox NetBox
After=postgresql.service redis.service
Requires=postgresql.service
Wants=redis.service
[Container]
Image={{ netbox_image }}
ContainerName=netbox
User={{ netbox_uid }}:0
DropCapability=all
NoNewPrivileges=true
Network=infrabox.network
PodmanArgs=--hosts-file=none
NetworkAlias=netbox.{{ infrabox_internal_domain }}
PublishPort=127.0.0.1:8080:8080
{% if platform_enabled | default(false) | bool %}
# Native Git Data Source trusts the appliance CA and the image's public CA directory.
Environment=SSL_CERT_FILE=/run/infrabox-ca/root-ca.crt
Environment=SSL_CERT_DIR=/etc/ssl/certs
{% endif %}
EnvironmentFile={{ infrabox_config_root }}/netbox/netbox.env
Volume={{ infrabox_config_root }}/netbox/configuration.py:/etc/netbox/config/configuration.py:ro,z
Volume={{ infrabox_config_root }}/netbox/ldap_config.py:/etc/netbox/config/ldap/ldap_config.py:ro,z
Volume={{ infrabox_config_root }}/netbox/infrabox_catalog.py:/opt/netbox/netbox/infrabox_catalog.py:ro,z
Volume={{ infrabox_config_root }}/netbox/infrabox_auth.py:/opt/netbox/netbox/infrabox_auth.py:ro,z
Volume={{ infrabox_storage_root }}/netbox/media:/opt/netbox/netbox/media:z
Volume={{ infrabox_storage_root }}/netbox/reports:/opt/netbox/netbox/reports:z
Volume={{ infrabox_storage_root }}/netbox/scripts:/opt/netbox/netbox/scripts:z
Volume={{ infrabox_root_ca_path }}:/run/infrabox-ca/root-ca.crt:ro,z
[Service]
Restart=on-failure
TimeoutStartSec=600
[Install]
WantedBy=multi-user.target
