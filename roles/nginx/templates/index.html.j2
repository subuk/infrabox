{# Presentation metadata only. URLs come from the same upstreams as nginx. #}
{% set services = [
  {'route': 'git', 'name': 'Gitea', 'category': 'Code & automation', 'description': 'A home for your code. Collaborate on repositories and put workflows into motion.', 'icon': 'git'},
  {'route': 'netbox', 'name': 'NetBox', 'category': 'Infrastructure inventory', 'description': 'The whole picture of your network. Organize devices, IP addresses, and connections.', 'icon': 'netbox'},
  {'route': 'grafana', 'name': 'Grafana', 'category': 'Monitoring & insights', 'description': 'See how your infrastructure is doing. Explore metrics, dashboards, and alerts.', 'icon': 'grafana'},
  {'route': 'vault', 'name': 'OpenBao', 'category': 'Secrets management', 'description': 'Keep credentials in the right hands. Manage secrets and access in one place.', 'icon': 'vault'},
  {'route': 'claw', 'name': 'OpenClaw', 'category': 'Your infrastructure assistant', 'description': 'Start a conversation with your infrastructure. Ask questions, explore your inventory, and get things done.', 'icon': 'claw'}
] %}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <meta name="description" content="Your InfraBox workspace. Open Gitea, NetBox, Grafana, OpenBao, and OpenClaw from one place.">
  <title>InfraBox — Your infrastructure, together</title>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%231c4e43'/%3E%3Cpath d='m16 6 9 5v10l-9 5-9-5V11Zm0 10 9-5m-9 5-9-5m9 5v10' fill='none' stroke='%23d8eee2' stroke-width='2' stroke-linejoin='round'/%3E%3C/svg%3E">
  <style>
    :root { color-scheme: light; --ink: #202c29; --muted: #5e6b65; --line: #dce2dc; --green: #255f4e; --paper: #f5f6f0; }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--paper); color: var(--ink); font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; -webkit-font-smoothing: antialiased; }
    a { color: inherit; }
    svg { display: block; }
    .shell { width: min(1160px, calc(100% - 96px)); margin-inline: auto; }
    .skip { position: absolute; left: 20px; top: -80px; z-index: 2; background: white; padding: 12px 20px; border-radius: 8px; }
    .skip:focus { top: 16px; }
    a:focus-visible { outline: 3px solid var(--green); outline-offset: 5px; }
    .topbar { min-height: 100px; display: flex; align-items: center; justify-content: space-between; gap: 24px; border-bottom: 1px solid var(--line); }
    .brand { display: flex; align-items: center; gap: 11px; font-size: 22px; font-weight: 750; letter-spacing: -.8px; }
    .brand-mark { width: 37px; height: 37px; display: grid; place-items: center; background: #214e42; border-radius: 11px; color: #e3f0de; }
    .brand-mark svg { width: 25px; height: 25px; }
    .host { display: flex; align-items: center; gap: 9px; font: 12px ui-monospace, SFMono-Regular, Consolas, monospace; color: var(--muted); min-width: 0; }
    .host span { overflow-wrap: anywhere; }
    .host svg { flex-shrink: 0; width: 14px; height: 14px; }
    .hero { display: grid; grid-template-columns: 1.3fr 1fr; gap: 36px; align-items: center; padding: 57px 0 50px; }
    .eyebrow { display: flex; align-items: center; gap: 9px; color: var(--green); font: 600 11px ui-monospace, SFMono-Regular, Consolas, monospace; letter-spacing: 1.9px; text-transform: uppercase; }
    .eyebrow::before { content: ""; width: 17px; height: 2px; background: currentColor; }
    h1 { margin: 20px 0 17px; font-size: clamp(38px, 4.8vw, 59px); line-height: 1.08; letter-spacing: -2.7px; font-weight: 620; }
    h1 span { color: var(--green); }
    .intro { color: var(--muted); max-width: 440px; font-size: 15px; line-height: 1.7; margin: 0; }
    .illustration { width: 100%; max-width: 370px; justify-self: center; }
    .section-heading { display: flex; align-items: baseline; gap: 12px; margin-bottom: 20px; }
    .section-heading h2 { margin: 0; font-size: 14px; font-weight: 650; }
    .count { color: #647069; background: #e7ebe3; padding: 3px 7px; border-radius: 5px; font: 11px ui-monospace, SFMono-Regular, Consolas, monospace; }
    .section-heading p { margin: 0 0 0 auto; color: var(--muted); font-size: 12px; }
    .services { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
    .card { position: relative; display: flex; flex-direction: column; min-height: 259px; padding: 25px 26px 22px; border: 1px solid var(--line); border-radius: 15px; background: #fdfefa; text-decoration: none; transition: border-color .18s, box-shadow .18s, transform .18s; }
    .card:hover { border-color: #91b4a1; box-shadow: 0 8px 22px #24382d0a; transform: translateY(-3px); }
    .card-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 19px; }
    .icon { width: 43px; height: 43px; display: grid; place-items: center; border: 1px solid #deeadb; border-radius: 12px; background: #edf3e8; color: #47743c; }
    .icon svg { width: 23px; height: 23px; fill: none; stroke: currentColor; stroke-width: 1.65; stroke-linecap: round; stroke-linejoin: round; }
    .card-netbox .icon { background: #e9eff8; color: #3e648e; border-color: #dce5f1; }
    .card-grafana .icon { background: #faf0e1; color: #9a5e20; border-color: #f1e5d0; }
    .card-vault .icon { background: #f1ecf7; color: #766091; border-color: #e6dfee; }
    .arrow { width: 17px; height: 17px; color: #68796f; fill: none; stroke: currentColor; stroke-width: 1.5; }
    .category { margin: 0 0 6px; color: var(--muted); font-size: 10px; letter-spacing: 1.05px; text-transform: uppercase; font-weight: 600; }
    .card h3 { margin: 0 0 9px; font-size: 23px; font-weight: 650; letter-spacing: -.65px; }
    .description { margin: 0; color: var(--muted); font-size: 13px; line-height: 1.65; max-width: 330px; }
    .card-bottom { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: auto; padding-top: 22px; }
    .address { color: var(--muted); font: 10px ui-monospace, SFMono-Regular, Consolas, monospace; overflow-wrap: anywhere; }
    .open { font-size: 11px; font-weight: 600; white-space: nowrap; }
    .card-claw { grid-column: span 2; background: #eaf1e8; border-color: #d5e0d3; padding-right: 180px; }
    .card-claw .icon { color: var(--green); background: #dbe9d8; border-color: #d0dfcc; }
    .card-claw .card-top { position: static; }
    .card-claw .card-top > .arrow { position: absolute; top: 39px; right: 26px; }
    .card-claw .description { max-width: 370px; }
    .card-claw .card-bottom { justify-content: flex-start; gap: 24px; }
    .assistant-art { position: absolute; width: 134px; height: 134px; right: 26px; top: 79px; color: #9fb7a0; }
    .footer { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-top: 35px; padding: 22px 0 28px; border-top: 1px solid var(--line); color: var(--muted); font-size: 11px; }
    .footer strong { font-weight: 600; color: #43574a; }
    .footer-note { font: 10px ui-monospace, SFMono-Regular, Consolas, monospace; letter-spacing: .2px; }
    @media (min-width: 1500px) { .hero { padding-block: 70px 60px; } }
    @media (max-width: 1000px) {
      .shell { width: calc(100% - 56px); }
      .services { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .hero { grid-template-columns: 1.4fr 1fr; gap: 12px; }
      h1 { font-size: 46px; }
      .card-claw { min-height: 240px; }
    }
    @media (max-width: 600px) {
      .shell { width: calc(100% - 36px); }
      .topbar { min-height: 84px; gap: 16px; }
      .brand { font-size: 20px; }
      .brand-mark { width: 32px; height: 32px; border-radius: 9px; }
      .host { font-size: 9px; max-width: 47%; }
      .host svg { display: none; }
      .hero { display: block; padding: 42px 0 33px; }
      h1 { font-size: clamp(36px, 9.7vw, 51px); letter-spacing: -1.9px; }
      .intro { font-size: 14px; max-width: 340px; }
      .illustration { display: none; }
      .eyebrow { font-size: 10px; }
      .section-heading { margin-bottom: 15px; }
      .section-heading p { display: none; }
      .services { grid-template-columns: minmax(0, 1fr); gap: 12px; }
      .card { min-height: 248px; padding: 22px; }
      .card-top { margin-bottom: 17px; }
      .card-claw { grid-column: auto; padding-right: 22px; }
      .assistant-art { display: none; }
      .card-claw .card-top > .arrow { top: 35px; right: 22px; }
      .card-claw .card-bottom { justify-content: space-between; gap: 12px; }
      .footer { margin-top: 26px; font-size: 10px; align-items: flex-start; }
      .footer-note { font-size: 9px; text-align: right; }
    }
    @media (prefers-reduced-motion: reduce) { .card { transition: none; } .card:hover { transform: none; } }
  </style>
</head>
<body>
  <a class="skip" href="#services">Skip to services</a>
  <div class="shell">
    <header class="topbar">
      <div class="brand"><span class="brand-mark"><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" aria-hidden="true"><path d="m16 4 11 6v12l-11 6-11-6V10Zm0 12 11-6m-11 6L5 10m11 6v12"/></svg></span>InfraBox</div>
      <div class="host"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><rect x="3" y="4" width="14" height="10" rx="2"/><path d="M7 17h6m-3-3v3"/></svg><span>{{ infrabox_domain | e }}</span></div>
    </header>
    <main>
      <section class="hero" aria-labelledby="welcome">
        <div>
          <div class="eyebrow">Your infrastructure workspace</div>
          <h1 id="welcome">Everything connected.<br><span>All in your hands.</span></h1>
          <p class="intro">Code, inventory, insights, and a little assistance.<br>Your tools, together in one place.</p>
        </div>
        <svg class="illustration" viewBox="0 0 380 245" fill="none" aria-hidden="true">
          <defs><pattern id="dots" width="18" height="18" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r=".85" fill="#cad5c9"/></pattern></defs>
          <rect x="8" y="5" width="364" height="232" fill="url(#dots)"/>
          <path d="m40 164 149 78 152-78M40 126l149 78 152-78" stroke="#d5dfd3"/>
          <path d="m87 157 102 54 104-54-104-54Z" fill="#e4eadd" stroke="#becbb9"/>
          <path d="M189 211v-20m104-34v-20M87 157v-20" stroke="#becbb9"/>
          <path d="m87 137 102 54 104-54-104-54Z" fill="#f7faf2" stroke="#becbb9"/>
          <path d="m111 85 78 41 79-41v67l-79 42-78-42Z" fill="#dbe9d4" stroke="#718f70" stroke-linejoin="round"/>
          <path d="m189 126 79-41v67l-79 42Z" fill="#b8cfb0" stroke="#718f70" stroke-linejoin="round"/>
          <path d="m111 85 78-41 79 41-79 41Z" fill="#edf5e5" stroke="#718f70" stroke-linejoin="round"/>
          <path d="m135 85 54-28 55 28-55 29Z" fill="#d1e3c7" stroke="#90ac84"/>
          <path d="m152 85 37-19 38 19-38 20Z" fill="#416e50"/>
          <path d="m128 117 42 22m-42-10 29 15m-29-3 42 22" stroke="#6b9265" stroke-width="3" stroke-linecap="round"/>
          <path d="m214 148 29-15m-29 27 29-15" stroke="#608157" stroke-width="3" stroke-linecap="round"/>
          <path d="M70 86 43 72V49m259 75 35-19V77m-148-51V9" stroke="#9db198" stroke-dasharray="3 4"/>
          <rect x="31" y="28" width="24" height="24" rx="7" fill="#f5f6f0" stroke="#a9bba3"/>
          <path d="m38 40 4 4 7-8" stroke="#6b8663" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          <rect x="325" y="55" width="24" height="24" rx="7" fill="#f5f6f0" stroke="#a9bba3"/>
          <path d="M331 68h3v5m3-12v12m3-8h3v8" stroke="#6b8663" stroke-width="1.5"/>
          <circle cx="189" cy="9" r="4" fill="#f5f6f0" stroke="#9db198"/>
        </svg>
      </section>
      <section id="services" aria-labelledby="services-heading">
        <div class="section-heading"><h2 id="services-heading">Your services</h2><span class="count">05</span><p>A place for every part of your infrastructure.</p></div>
        <div class="services">
{% for service in services %}
{% set upstream = nginx_upstreams | selectattr('name', 'equalto', service.route) | first %}
{% set hostname = upstream.hostname | default(upstream.name ~ '.' ~ infrabox_domain) %}
          <a class="card card-{{ service.route }}" href="https://{{ hostname | e }}/" aria-labelledby="title-{{ service.route }}" aria-describedby="description-{{ service.route }}">
            <div class="card-top">
              <span class="icon"><svg viewBox="0 0 24 24" aria-hidden="true">
{% if service.icon == 'git' %}
                <circle cx="7" cy="5" r="2.3"/><circle cx="7" cy="19" r="2.3"/><circle cx="17" cy="6" r="2.3"/><path d="M7 7.3v9.4M17 8.3v2a4 4 0 0 1-4 4H7"/>
{% elif service.icon == 'netbox' %}
                <path d="m12 3 8 4.5v9L12 21l-8-4.5v-9Zm0 9 8-4.5M12 12 4 7.5M12 12v9"/>
{% elif service.icon == 'grafana' %}
                <path d="M4 19V5m0 14h16M8 15v-4m5 4V6m5 9v-7"/>
{% elif service.icon == 'vault' %}
                <rect x="4" y="3" width="16" height="18" rx="3"/><circle cx="12" cy="11" r="3.5"/><path d="M12 7.5V6m0 10v-1.5m3.5-3.5H17M7 11h1.5m1 7h5"/>
{% else %}
                <path d="m12 2 2.6 7.4L22 12l-7.4 2.6L12 22l-2.6-7.4L2 12l7.4-2.6Z"/>
{% endif %}
              </svg></span>
              <svg class="arrow" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 16 16 4M5 4h11v11"/></svg>
            </div>
            <p class="category">{{ service.category }}</p>
            <h3 id="title-{{ service.route }}">{{ service.name }}</h3>
            <p class="description" id="description-{{ service.route }}">{{ service.description }}</p>
{% if service.route == 'claw' %}
            <svg class="assistant-art" viewBox="0 0 140 140" fill="none" aria-hidden="true"><circle cx="70" cy="70" r="61" stroke="currentColor" stroke-dasharray="2 7"/><circle cx="70" cy="70" r="46" stroke="currentColor" opacity=".4"/><path d="m70 28 11 31 31 11-31 11-11 31-11-31-31-11 31-11Z" fill="#d2e2cc" stroke="#7e9d78"/><path d="m70 49 5.5 15.5L91 70l-15.5 5.5L70 91l-5.5-15.5L49 70l15.5-5.5Z" fill="#7e9d78"/></svg>
{% endif %}
            <div class="card-bottom"><span class="address">{{ hostname | e }}</span><span class="open" aria-hidden="true">Open {{ service.name }} &rarr;</span></div>
          </a>
{% endfor %}
        </div>
      </section>
    </main>
    <footer class="footer"><span><strong>InfraBox</strong> &nbsp;/&nbsp; Infrastructure, together.</span><span class="footer-note">Your tools. Your infrastructure.</span></footer>
  </div>
</body>
</html>
