{
  "gateway": {
    "mode": "local", "bind": "lan", "port": {{ openclaw_port }},
    "publicOrigin": {{ ("https://" ~ openclaw_hostname) | to_json }},
    "terminal": {"enabled": false},
    "auth": {"mode": "token"},
    "trustedProxies": {{ (openclaw_backend_network.stdout | from_json)[0].subnets | map(attribute="gateway") | list | to_json }},
    "tls": {"enabled": false, "autoGenerate": false},
    "controlUi": {"enabled": true, "allowedOrigins": [{{ ("https://" ~ openclaw_hostname) | to_json }}]}
  },
  "agents": {"defaults": {"workspace": "/home/node/.openclaw/workspace", "sandbox": {"mode": "off"}}},
{% if openclaw_netbox_enabled | bool %}
  "tools": {
    "profile": "messaging", "alsoAllow": {{ (["read"] + (["infrabox_scan_subnet"] if openclaw_subnet_scan_enabled | bool else []) + (["web_search"] if openclaw_web_search_enabled | bool else [])) | to_json }}, "fs": {"workspaceOnly": true},
    "web": {"search": {"enabled": {{ openclaw_web_search_enabled | bool | to_json }}}},
    "deny": ["exec", "process", "browser", "nodes", "terminal", "write", "edit", "apply_patch",
      "secrets", "sessions", "sessions_list", "sessions_history", "sessions_search", "conversations_list",
      "conversations_send", "conversations_turn", "sessions_send", "sessions_spawn", "sessions_yield", "subagents", "message"]
  },
  "mcp": {"servers": {"netbox": {
    "command": "/usr/local/bin/infrabox-netbox-mcp", "transport": "stdio",
    "env": {"NETBOX_URL": {{ openclaw_netbox_url | to_json }}, "NODE_EXTRA_CA_CERTS": "/run/infrabox-ca/root-ca.crt"},
    "toolFilter": {"include": ["netbox_global_search", "netbox_discover", "netbox_describe", "netbox_read", "netbox_write"]}
  }}},
  "skills": {"allowBundled": [], "entries": {"netbox-onboarding": {"enabled": true}}},
{% else %}
  "tools": {"profile": "minimal", "alsoAllow": {{ ((["infrabox_scan_subnet"] if openclaw_subnet_scan_enabled | bool else []) + (["web_search"] if openclaw_web_search_enabled | bool else [])) | to_json }},
    "web": {"search": {"enabled": {{ openclaw_web_search_enabled | bool | to_json }}}},
    "deny": ["exec", "process", "browser", "nodes", "terminal"]},
{% endif %}
  "plugins": {"allow": {{ (["vault"] + (["infrabox-subnet-scan"] if openclaw_subnet_scan_enabled | bool else []) + (["openai"] if openclaw_web_search_enabled | bool or 'openai' in openclaw_model_providers else [])) | to_json }},
{% if openclaw_subnet_scan_enabled | bool %}
    "load": {"paths": ["/opt/infrabox/plugins/subnet-scan"]},
{% endif %}
    "entries": {"vault": {"enabled": true}{% if openclaw_subnet_scan_enabled | bool %}, "infrabox-subnet-scan": {"enabled": true}{% endif %}{% if openclaw_web_search_enabled | bool or 'openai' in openclaw_model_providers %}, "openai": {"enabled": true}{% endif %}}},
  "secrets": {"providers": {"vault": {"source": "exec", "pluginIntegration": {"pluginId": "vault", "integrationId": "vault"}}}},
  "models": {"providers": {{ openclaw_model_providers | to_json }}}
}
