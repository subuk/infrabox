OPENCLAW_CONFIG_PATH=/etc/openclaw/openclaw.json
OPENCLAW_STATE_DIR=/home/node/.openclaw
OPENCLAW_GATEWAY_TOKEN={{ openclaw_gateway_token }}
NODE_EXTRA_CA_CERTS=/run/infrabox-ca/root-ca.crt
VAULT_ADDR={{ openclaw_openbao_address }}
OPENCLAW_VAULT_AUTH_METHOD=token_file
VAULT_TOKEN_FILE=/run/openclaw-secrets/vault-token
OPENCLAW_VAULT_KV_MOUNT={{ openclaw_openbao_kv_mount }}
OPENCLAW_VAULT_KV_VERSION=2
{% if openclaw_http_proxy or openclaw_https_proxy %}
NODE_USE_ENV_PROXY=1
HTTP_PROXY={{ openclaw_http_proxy }}
HTTPS_PROXY={{ openclaw_https_proxy }}
NO_PROXY={{ openclaw_no_proxy }}
{% endif %}
