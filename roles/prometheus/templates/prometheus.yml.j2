global:
  scrape_interval: 30s
  evaluation_interval: 30s
rule_files:
  - /etc/prometheus/current/rules.json
scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ['localhost:9090']
  - job_name: node
    scrape_timeout: 10s
    sample_limit: 10000
    static_configs:
      - targets: ['{{ prometheus_node_exporter_address }}:9100']
